/* ---------- Search Functions ---------- */

int carExists(int id) {
    Car car;
    FILE *fp = fopen(CAR_FILE, "rb");

    if (fp == NULL)
        return 0;

    while (fread(&car, sizeof(Car), 1, fp)) {
        if (car.id == id) {
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

int customerExists(int id) {
    Customer customer;
    FILE *fp = fopen(CUSTOMER_FILE, "rb");

    if (fp == NULL)
        return 0;

    while (fread(&customer, sizeof(Customer), 1, fp)) {
        if (customer.id == id) {
            fclose(fp);
            return 1;
        }
    }

    fclose(fp);
    return 0;
}

int isCarAvailable(int id) {
    Car car;
    FILE *fp = fopen(CAR_FILE, "rb");

    if (fp == NULL)
        return 0;

    while (fread(&car, sizeof(Car), 1, fp)) {
        if (car.id == id) {
            fclose(fp);
            return car.available;
        }
    }

    fclose(fp);
    return 0;
}

float getCarPrice(int id) {
    Car car;
    FILE *fp = fopen(CAR_FILE, "rb");

    if (fp == NULL)
        return 0;

    while (fread(&car, sizeof(Car), 1, fp)) {
        if (car.id == id) {
            fclose(fp);
            return car.pricePerDay;
        }
    }

    fclose(fp);
    return 0;
}

/* ---------- Rental Functions ---------- */

int generateRentalId() {
    Rental rental;
    FILE *fp = fopen(RENTAL_FILE, "rb");
    int maxId = 1000;

    if (fp == NULL)
        return maxId + 1;

    while (fread(&rental, sizeof(Rental), 1, fp)) {
        if (rental.rentalId > maxId)
            maxId = rental.rentalId;
    }

    fclose(fp);

    return maxId + 1;
}

void rentCar() {
    Rental rental;
    float price;

    printf("\n========== RENT A CAR ==========\n");

    printf("Enter Customer ID: ");
    scanf("%d", &rental.customerId);

    if (!customerExists(rental.customerId)) {
        printf("\nCustomer does not exist!\n");
        return;
    }

    printf("Enter Car ID: ");
    scanf("%d", &rental.carId);

    if (!carExists(rental.carId)) {
        printf("\nCar does not exist!\n");
        return;
    }

    if (!isCarAvailable(rental.carId)) {
        printf("\nCar is already rented!\n");
        return;
    }

    printf("Enter Number of Days: ");
    scanf("%d", &rental.days);

    if (rental.days <= 0) {
        printf("\nInvalid number of days!\n");
        return;
    }

    price = getCarPrice(rental.carId);

    rental.rentalId = generateRentalId();
    rental.total = price * rental.days;
    rental.returned = 0;

    getDate(rental.date);

    FILE *fp = fopen(RENTAL_FILE, "ab");

    if (fp == NULL) {
        printf("Error opening rental file!\n");
        return;
    }

    fwrite(&rental, sizeof(Rental), 1, fp);
    fclose(fp);

    updateCarAvailability(rental.carId, 0);

    printf("\n====================================\n");
    printf("         CAR RENTED SUCCESSFULLY\n");
    printf("====================================\n");
    printf("Rental ID     : %d\n", rental.rentalId);
    printf("Customer ID   : %d\n", rental.customerId);
    printf("Car ID        : %d\n", rental.carId);
    printf("Days          : %d\n", rental.days);
    printf("Price/Day     : %.2f\n", price);
    printf("Total Amount  : %.2f\n", rental.total);
    printf("Date          : %s\n", rental.date);
    printf("====================================\n");
}

/* ---------- Return Car ---------- */

void returnCar() {
    Rental rental;
    int rentalId;
    int found = 0;

    printf("\n========== RETURN CAR ==========\n");

    printf("Enter Rental ID: ");
    scanf("%d", &rentalId);

    FILE *fp = fopen(RENTAL_FILE, "rb+");

    if (fp == NULL) {
        printf("\nNo rental records found.\n");
        return;
    }

    while (fread(&rental, sizeof(Rental), 1, fp)) {

        if (rental.rentalId == rentalId) {
            found = 1;

            if (rental.returned) {
                printf("\nThis car has already been returned.\n");
                fclose(fp);
                return;
            }

            rental.returned = 1;

            fseek(fp, -(long)sizeof(Rental), SEEK_CUR);
            fwrite(&rental, sizeof(Rental), 1, fp);

            updateCarAvailability(rental.carId, 1);

            printf("\n====================================\n");
            printf("          CAR RETURNED\n");
            printf("====================================\n");
            printf("Rental ID    : %d\n", rental.rentalId);
            printf("Car ID       : %d\n", rental.carId);
            printf("Total Bill   : %.2f\n", rental.total);
            printf("Return Status: Returned\n");
            printf("====================================\n");

            break;
        }
    }

    fclose(fp);

    if (!found)
        printf("\nRental ID not found!\n");
}

