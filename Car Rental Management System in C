#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define CAR_FILE "cars.dat"
#define CUSTOMER_FILE "customers.dat"
#define RENTAL_FILE "rentals.dat"

typedef struct {
    int id;
    char brand[50];
    char model[50];
    char number[20];
    float pricePerDay;
    int available;
} Car;

typedef struct {
    int id;
    char name[50];
    char phone[20];
    char license[30];
} Customer;

typedef struct {
    int rentalId;
    int carId;
    int customerId;
    int days;
    float total;
    char date[30];
    int returned;
} Rental;

/* ---------- Utility Functions ---------- */

void clearInput() {
    int c;
    while ((c = getchar()) != '\n' && c != EOF);
}

void pauseScreen() {
    printf("\nPress Enter to continue...");
    getchar();
}

void getDate(char *date) {
    time_t t = time(NULL);
    struct tm *tm_info = localtime(&t);

    strftime(date, 30, "%d-%m-%Y %H:%M:%S", tm_info);
}

/* ---------- Car Functions ---------- */

void addCar() {
    Car car;
    FILE *fp = fopen(CAR_FILE, "ab");

    if (fp == NULL) {
        printf("Error opening file!\n");
        return;
    }

    printf("\n========== ADD CAR ==========\n");

    printf("Enter Car ID: ");
    scanf("%d", &car.id);
    clearInput();

    printf("Enter Brand: ");
    fgets(car.brand, sizeof(car.brand), stdin);
    car.brand[strcspn(car.brand, "\n")] = '\0';

    printf("Enter Model: ");
    fgets(car.model, sizeof(car.model), stdin);
    car.model[strcspn(car.model, "\n")] = '\0';

    printf("Enter Registration Number: ");
    fgets(car.number, sizeof(car.number), stdin);
    car.number[strcspn(car.number, "\n")] = '\0';

    printf("Enter Price Per Day: ");
    scanf("%f", &car.pricePerDay);

    car.available = 1;

    fwrite(&car, sizeof(Car), 1, fp);
    fclose(fp);

    printf("\nCar added successfully!\n");
}

void displayCars() {
    Car car;
    FILE *fp = fopen(CAR_FILE, "rb");

    if (fp == NULL) {
        printf("\nNo car records found.\n");
        return;
    }

    printf("\n================ CAR LIST ================\n");

    printf("%-5s %-15s %-15s %-15s %-12s %-12s\n",
           "ID", "Brand", "Model", "Number", "Price/Day", "Status");

    printf("---------------------------------------------------------------\n");

    while (fread(&car, sizeof(Car), 1, fp)) {
        printf("%-5d %-15s %-15s %-15s %-12.2f %-12s\n",
               car.id,
               car.brand,
               car.model,
               car.number,
               car.pricePerDay,
               car.available ? "Available" : "Rented");
    }

    fclose(fp);
}

void updateCarAvailability(int carId, int status) {
    Car car;
    FILE *fp = fopen(CAR_FILE, "rb+");

    if (fp == NULL)
        return;

    while (fread(&car, sizeof(Car), 1, fp)) {
        if (car.id == carId) {
            car.available = status;

            fseek(fp, -(long)sizeof(Car), SEEK_CUR);
            fwrite(&car, sizeof(Car), 1, fp);
            break;
        }
    }

    fclose(fp);
}

