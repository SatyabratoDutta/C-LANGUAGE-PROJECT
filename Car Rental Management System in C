/* ---------- Search Car ---------- */

void searchCar() {
    Car car;
    int id;
    int found = 0;

    printf("\nEnter Car ID to search: ");
    scanf("%d", &id);

    FILE *fp = fopen(CAR_FILE, "rb");

    if (fp == NULL) {
        printf("\nNo car records found.\n");
        return;
    }

    while (fread(&car, sizeof(Car), 1, fp)) {

        if (car.id == id) {
            found = 1;

            printf("\n========== CAR DETAILS ==========\n");
            printf("Car ID        : %d\n", car.id);
            printf("Brand         : %s\n", car.brand);
            printf("Model         : %s\n", car.model);
            printf("Number        : %s\n", car.number);
            printf("Price Per Day : %.2f\n", car.pricePerDay);
            printf("Status        : %s\n",
                   car.available ? "Available" : "Rented");

            break;
        }
    }

    fclose(fp);

    if (!found)
        printf("\nCar not found!\n");
}

/* ---------- Admin Login ---------- */

int adminLogin() {
    char username[30];
    char password[30];

    printf("\n====================================\n");
    printf("       CAR RENTAL SYSTEM LOGIN\n");
    printf("====================================\n");

    printf("Username: ");
    scanf("%29s", username);

    printf("Password: ");
    scanf("%29s", password);

    if (strcmp(username, "admin") == 0 &&
        strcmp(password, "1234") == 0) {

        printf("\nLogin successful!\n");
        return 1;
    }

    printf("\nInvalid username or password!\n");
    return 0;
}

/* ---------- Main Menu ---------- */

void menu() {
    int choice;

    while (1) {

        printf("\n\n");
        printf("============================================\n");
        printf("       CAR RENTAL MANAGEMENT SYSTEM\n");
        printf("============================================\n");
        printf("1.  Add Car\n");
        printf("2.  Display All Cars\n");
        printf("3.  Search Car\n");
        printf("4.  Add Customer\n");
        printf("5.  Display Customers\n");
        printf("6.  Rent Car\n");
        printf("7.  Return Car\n");
        printf("8.  Rental History\n");
        printf("9.  Exit\n");
        printf("============================================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                addCar();
                pauseScreen();
                break;

            case 2:
                displayCars();
                pauseScreen();
                break;

            case 3:
                searchCar();
                pauseScreen();
                break;

            case 4:
                addCustomer();
                pauseScreen();
                break;

            case 5:
                displayCustomers();
                pauseScreen();
                break;

            case 6:
                rentCar();
                pauseScreen();
                break;

            case 7:
                returnCar();
                pauseScreen();
                break;

            case 8:
                displayRentals();
                pauseScreen();
                break;

            case 9:
                printf("\nThank you for using Car Rental System!\n");
                exit(0);

            default:
                printf("\nInvalid choice! Please try again.\n");
                clearInput();
        }
    }
}

/* ---------- Main ---------- */

int main() {

    if (!adminLogin()) {
        return 0;
    }

    menu();

    return 0;
}
