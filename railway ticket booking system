#include <stdio.h>
#include <string.h>

#define MAX_SEATS 50

struct Passenger {
    int seatNo;
    char name[50];
    int age;
    char gender[10];
    char train[50];
    char from[30];
    char to[30];
    int booked;
};

struct Passenger passengers[MAX_SEATS];

void initializeSeats() {
    for (int i = 0; i < MAX_SEATS; i++) {
        passengers[i].seatNo = i + 1;
        passengers[i].booked = 0;
    }
}

void displayTrains() {
    printf("\n========== AVAILABLE TRAINS ==========\n");
    printf("1. Express Bengal       | Kolkata -> Delhi\n");
    printf("2. Rajdhani Express     | Kolkata -> Mumbai\n");
    printf("3. Duronto Express      | Kolkata -> Delhi\n");
    printf("4. Shatabdi Express     | Kolkata -> Patna\n");
    printf("======================================\n");
}

void bookTicket() {
    int seat, trainChoice;

    printf("\n========== BOOK TICKET ==========\n");

    printf("Enter seat number (1-%d): ", MAX_SEATS);
    scanf("%d", &seat);

    if (seat < 1 || seat > MAX_SEATS) {
        printf("Invalid seat number!\n");
        return;
    }

    if (passengers[seat - 1].booked == 1) {
        printf("Sorry! Seat %d is already booked.\n", seat);
        return;
    }

    displayTrains();

    printf("Select train: ");
    scanf("%d", &trainChoice);

    if (trainChoice < 1 || trainChoice > 4) {
        printf("Invalid train choice!\n");
        return;
    }

    passengers[seat - 1].seatNo = seat;

    printf("Enter passenger name: ");
    scanf(" %[^\n]", passengers[seat - 1].name);

    printf("Enter age: ");
    scanf("%d", &passengers[seat - 1].age);

    printf("Enter gender: ");
    scanf("%s", passengers[seat - 1].gender);

    printf("Enter source station: ");
    scanf(" %[^\n]", passengers[seat - 1].from);

    printf("Enter destination station: ");
    scanf(" %[^\n]", passengers[seat - 1].to);

    switch (trainChoice) {
        case 1:
            strcpy(passengers[seat - 1].train, "Express Bengal");
            break;

        case 2:
            strcpy(passengers[seat - 1].train, "Rajdhani Express");
            break;

        case 3:
            strcpy(passengers[seat - 1].train, "Duronto Express");
            break;

        case 4:
            strcpy(passengers[seat - 1].train, "Shatabdi Express");
            break;
    }

    passengers[seat - 1].booked = 1;

    printf("\nTicket booked successfully!\n");
    printf("Your Seat Number: %d\n", seat);
}

void viewTickets() {
    int found = 0;

    printf("\n========== BOOKED TICKETS ==========\n");

    for (int i = 0; i < MAX_SEATS; i++) {

        if (passengers[i].booked == 1) {

            found = 1;

            printf("\nSeat Number   : %d", passengers[i].seatNo);
            printf("\nPassenger Name : %s", passengers[i].name);
            printf("\nAge            : %d", passengers[i].age);
            printf("\nGender         : %s", passengers[i].gender);
            printf("\nTrain          : %s", passengers[i].train);
            printf("\nFrom           : %s", passengers[i].from);
            printf("\nTo             : %s", passengers[i].to);
            printf("\n------------------------------------\n");
        }
    }

    if (found == 0) {
        printf("No tickets are booked.\n");
    }
}

void cancelTicket() {
    int seat;

    printf("\n========== CANCEL TICKET ==========\n");

    printf("Enter seat number: ");
    scanf("%d", &seat);

    if (seat < 1 || seat > MAX_SEATS) {
        printf("Invalid seat number!\n");
        return;
    }

    if (passengers[seat - 1].booked == 0) {
        printf("No ticket found for seat %d.\n", seat);
        return;
    }

    passengers[seat - 1].booked = 0;

    printf("Ticket for seat %d cancelled successfully!\n", seat);
}

void seatAvailability() {
    int booked = 0;

    printf("\n========== SEAT AVAILABILITY ==========\n");

    for (int i = 0; i < MAX_SEATS; i++) {

        if (passengers[i].booked == 1) {
            printf("Seat %d : BOOKED\n", i + 1);
            booked++;
        } else {
            printf("Seat %d : AVAILABLE\n", i + 1);
        }
    }

    printf("\nTotal Seats     : %d", MAX_SEATS);
    printf("\nBooked Seats    : %d", booked);
    printf("\nAvailable Seats : %d\n", MAX_SEATS - booked);
}

int main() {

    int choice;

    initializeSeats();

    while (1) {

        printf("\n\n========================================\n");
        printf("     RAILWAY TICKET BOOKING SYSTEM\n");
        printf("========================================\n");

        printf("1. Display Trains\n");
        printf("2. Book Ticket\n");
        printf("3. View Booked Tickets\n");
        printf("4. Cancel Ticket\n");
        printf("5. Check Seat Availability\n");
        printf("6. Exit\n");

        printf("========================================\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                displayTrains();
                break;

            case 2:
                bookTicket();
                break;

            case 3:
                viewTickets();
                break;

            case 4:
                cancelTicket();
                break;

            case 5:
                seatAvailability();
                break;

            case 6:
                printf("\nThank you for using Railway Ticket Booking System!\n");
                return 0;

            default:
                printf("\nInvalid choice! Please try again.\n");
        }
    }

    return 0;
}
