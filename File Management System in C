#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAX 1000

void createFile();
void writeFile();
void readFile();
void appendFile();
void renameFile();
void deleteFile();
void copyFile();
void searchFile();
void fileInfo();

int main()
{
    int choice;

    while (1)
    {
        printf("\n========================================\n");
        printf("        FILE MANAGEMENT SYSTEM\n");
        printf("========================================\n");
        printf("1. Create File\n");
        printf("2. Write to File\n");
        printf("3. Read File\n");
        printf("4. Append to File\n");
        printf("5. Rename File\n");
        printf("6. Delete File\n");
        printf("7. Copy File\n");
        printf("8. Search Text in File\n");
        printf("9. File Information\n");
        printf("10. Exit\n");
        printf("========================================\n");

        printf("Enter your choice: ");
        scanf("%d", &choice);
        getchar();

        switch (choice)
        {
            case 1:
                createFile();
                break;

            case 2:
                writeFile();
                break;

            case 3:
                readFile();
                break;

            case 4:
                appendFile();
                break;

            case 5:
                renameFile();
                break;

            case 6:
                deleteFile();
                break;

            case 7:
                copyFile();
                break;

            case 8:
                searchFile();
                break;

            case 9:
                fileInfo();
                break;

            case 10:
                printf("\nThank you for using File Management System!\n");
                exit(0);

            default:
                printf("\nInvalid choice!\n");
        }
    }

    return 0;
}

/* Create File */

void createFile()
{
    char filename[100];
    FILE *fp;

    printf("\nEnter file name: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    fp = fopen(filename, "w");

    if (fp == NULL)
    {
        printf("Error: File could not be created.\n");
        return;
    }

    fclose(fp);

    printf("File '%s' created successfully.\n", filename);
}

/* Write File */

void writeFile()
{
    char filename[100];
    char text[MAX];
    FILE *fp;

    printf("\nEnter file name: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    fp = fopen(filename, "w");

    if (fp == NULL)
    {
        printf("Error opening file.\n");
        return;
    }

    printf("Enter text to write:\n");
    fgets(text, sizeof(text), stdin);

    fprintf(fp, "%s", text);

    fclose(fp);

    printf("Data written successfully.\n");
}

/* Read File */

void readFile()
{
    char filename[100];
    char ch;
    FILE *fp;

    printf("\nEnter file name: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    fp = fopen(filename, "r");

    if (fp == NULL)
    {
        printf("File not found.\n");
        return;
    }

    printf("\n========== FILE CONTENT ==========\n");

    while ((ch = fgetc(fp)) != EOF)
    {
        putchar(ch);
    }

    printf("\n==================================\n");

    fclose(fp);
}

/* Append File */

void appendFile()
{
    char filename[100];
    char text[MAX];
    FILE *fp;

    printf("\nEnter file name: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    fp = fopen(filename, "a");

    if (fp == NULL)
    {
        printf("Error opening file.\n");
        return;
    }

    printf("Enter text to append:\n");
    fgets(text, sizeof(text), stdin);

    fprintf(fp, "%s", text);

    fclose(fp);

    printf("Data appended successfully.\n");
}

/* Rename File */

void renameFile()
{
    char oldName[100];
    char newName[100];

    printf("\nEnter old file name: ");
    fgets(oldName, sizeof(oldName), stdin);
    oldName[strcspn(oldName, "\n")] = '\0';

    printf("Enter new file name: ");
    fgets(newName, sizeof(newName), stdin);
    newName[strcspn(newName, "\n")] = '\0';

    if (rename(oldName, newName) == 0)
    {
        printf("File renamed successfully.\n");
    }
    else
    {
        printf("Error: Could not rename file.\n");
    }
}

/* Delete File */

void deleteFile()
{
    char filename[100];
    char confirm;

    printf("\nEnter file name to delete: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    printf("Are you sure you want to delete '%s'? (y/n): ",
           filename);

    scanf("%c", &confirm);
    getchar();

    if (confirm == 'y' || confirm == 'Y')
    {
        if (remove(filename) == 0)
        {
            printf("File deleted successfully.\n");
        }
        else
        {
            printf("Error: File could not be deleted.\n");
        }
    }
    else
    {
        printf("Delete operation cancelled.\n");
    }
}

/* Copy File */

void copyFile()
{
    char source[100];
    char destination[100];

    FILE *sourceFile;
    FILE *destinationFile;

    char ch;

    printf("\nEnter source file name: ");
    fgets(source, sizeof(source), stdin);
    source[strcspn(source, "\n")] = '\0';

    printf("Enter destination file name: ");
    fgets(destination, sizeof(destination), stdin);
    destination[strcspn(destination, "\n")] = '\0';

    sourceFile = fopen(source, "rb");

    if (sourceFile == NULL)
    {
        printf("Source file not found.\n");
        return;
    }

    destinationFile = fopen(destination, "wb");

    if (destinationFile == NULL)
    {
        fclose(sourceFile);
        printf("Could not create destination file.\n");
        return;
    }

    while ((ch = fgetc(sourceFile)) != EOF)
    {
        fputc(ch, destinationFile);
    }

    fclose(sourceFile);
    fclose(destinationFile);

    printf("File copied successfully.\n");
}

/* Search Text */

void searchFile()
{
    char filename[100];
    char search[100];
    char line[MAX];

    FILE *fp;

    int found = 0;
    int lineNumber = 0;

    printf("\nEnter file name: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    printf("Enter text to search: ");
    fgets(search, sizeof(search), stdin);
    search[strcspn(search, "\n")] = '\0';

    fp = fopen(filename, "r");

    if (fp == NULL)
    {
        printf("File not found.\n");
        return;
    }

    while (fgets(line, sizeof(line), fp))
    {
        lineNumber++;

        if (strstr(line, search) != NULL)
        {
            printf("\nText found at line %d:\n", lineNumber);
            printf("%s", line);

            found = 1;
        }
    }

    fclose(fp);

    if (!found)
    {
        printf("\nText '%s' was not found in the file.\n",
               search);
    }
}

/* File Information */

void fileInfo()
{
    char filename[100];
    FILE *fp;

    long size;
    int lines = 0;
    int words = 0;
    int characters = 0;

    char ch;
    int inWord = 0;

    printf("\nEnter file name: ");
    fgets(filename, sizeof(filename), stdin);
    filename[strcspn(filename, "\n")] = '\0';

    fp = fopen(filename, "r");

    if (fp == NULL)
    {
        printf("File not found.\n");
        return;
    }

    fseek(fp, 0, SEEK_END);

    size = ftell(fp);

    rewind(fp);

    while ((ch = fgetc(fp)) != EOF)
    {
        characters++;

        if (ch == '\n')
        {
            lines++;
        }

        if (ch == ' ' ||
            ch == '\n' ||
            ch == '\t')
        {
            inWord = 0;
        }
        else if (inWord == 0)
        {
            words++;
            inWord = 1;
        }
    }

    fclose(fp);

    printf("\n========== FILE INFORMATION ==========\n");
    printf("File Name      : %s\n", filename);
    printf("File Size      : %ld bytes\n", size);
    printf("Lines          : %d\n", lines);
    printf("Words          : %d\n", words);
    printf("Characters     : %d\n", characters);
    printf("======================================\n");
}
