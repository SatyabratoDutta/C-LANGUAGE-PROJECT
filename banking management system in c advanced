    while (1) {

        printf("\n\n========== CUSTOMER MENU ==========\n");
        printf("1. Check Balance\n");
        printf("2. Deposit Money\n");
        printf("3. Withdraw Money\n");
        printf("4. Transfer Money\n");
        printf("5. Transaction History\n");
        printf("6. Logout\n");

        printf("Enter Choice: ");
        scanf("%d", &choice);

        switch (choice) {

            case 1:
                if (getAccount(accountNo, &acc))
                    printf("\nCurrent Balance: Rs. %.2lf\n",
                           acc.balance);
                break;

            case 2:
                depositMoney();
                break;

            case 3:
                withdrawMoney();
                break;

            case 4:
                transferMoney();
                break;

            case 5:
                transactionHistory();
                break;

            case 6:
                printf("\nLogged out successfully.\n");
                return;

            default:
                printf("\nInvalid choice!\n");
        }
    }
}

